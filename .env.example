# 复制为 .env 后按需修改（真实 .env 不要提交）
# 数据库
DB_URL=jdbc:mysql://localhost:3306/zhihui_mall?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
DB_USERNAME=root
DB_PASSWORD=1234
# JWT（生产必须替换为随机 32 字节以上密钥）
JWT_SECRET=zhihui-demo-jwt-secret-key-change-me-in-production-0123456789abcdef
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
